PORT=3000
NODE_ENV=development
# Dirección pública de cada proyecto (en Heroku, la URL de cada app)
QPROPIEDADES_URL=http://localhost:3001
QCASA_URL=http://localhost:3002/qcasa

# ---- Estadísticas de visitas (panel privado) ----
# Dirección del panel (no se enlaza desde ninguna página). Elegí algo difícil de adivinar.
PANEL_RUTA=panel-privado-qr
PANEL_USUARIO=admin
# Sin PANEL_CLAVE el panel queda desactivado.
PANEL_CLAVE=
# Texto largo al azar para firmar la sesión (si lo cambiás, tenés que volver a marcar tus dispositivos).
PANEL_SECRETO=
# Base de datos donde se guardan las visitas (MongoDB Atlas gratuito). Sin esto se pierden al reiniciar Heroku.
MONGODB_URI=
# Días que se guardan las visitas
ESTADISTICAS_DIAS=365
