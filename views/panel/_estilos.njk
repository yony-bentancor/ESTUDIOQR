<meta name="robots" content="noindex,nofollow">
<style>
  :root{--bg:#fbfaf7;--card:#fff;--ink:#141414;--muted:#837f78;--line:#e4dfd7;--gold:#b58955;--gold-soft:#f3ece2;--alert:#b4472f;--alert-soft:#f8e6e1;--ok:#2f7a55;--ok-soft:#e3f1e9}
  @media (prefers-color-scheme:dark){:root{--bg:#121212;--card:#1b1b1b;--ink:#efece7;--muted:#9a958e;--line:#2e2c29;--gold:#c99d69;--gold-soft:#2a241c;--alert:#e07a62;--alert-soft:#33211c;--ok:#6cc296;--ok-soft:#1b2a22}}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Arial,Helvetica,sans-serif}
  a{color:var(--gold)}
  .marca{font-weight:800;letter-spacing:.28em;font-size:15px;white-space:nowrap}
  .marca b{color:var(--gold);font-weight:600;letter-spacing:.04em}
  .eyebrow{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
  input,select,button{font:inherit;color:inherit}
  input,select{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:9px 11px;width:100%}
  .btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--ink);background:var(--ink);color:var(--bg);border-radius:6px;padding:8px 14px;cursor:pointer;text-decoration:none;font-weight:700;font-size:13px;white-space:nowrap}
  .btn.claro{background:transparent;color:var(--ink);border-color:var(--line)}
  .btn.mini{padding:4px 9px;font-size:12px;font-weight:600}
</style>
